# Required: create an API key in Alibaba Cloud Model Studio (DashScope).
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
DASHSCOPE_CHAT_MODEL=qwen3.7-flash
DASHSCOPE_CHAT_MULTI_MODEL=true

# Optional: leave empty to disable the web-search tool.
SEARCH_API_KEY=

# Required: generate with `openssl rand -hex 32`.
AUTH_JWT_SECRET=replace-with-a-random-64-character-hex-string
AUTH_JWT_EXPIRATION_MS=7200000

# Required: the first demo startup creates this administrator account.
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# Keep true only while invited friends create accounts, then set false and restart.
AUTH_REGISTRATION_ENABLED=true

# Per authenticated user. Set 0 only if you intentionally want no application-level limit.
AI_REQUESTS_PER_MINUTE=6

# Local H2 settings. The named Docker volume preserves the database across restarts.
CHAT_DATABASE_USERNAME=root
CHAT_DATABASE_PASSWORD=

# Conversation privacy and retention. Set retention days below 1 to disable automatic cleanup.
CHAT_RETENTION_DAYS=365
CHAT_RETENTION_BATCH_SIZE=500
CHAT_RETENTION_CLEANUP_CRON=0 15 3 * * *
# Keep false outside short-lived, access-controlled debugging sessions.
AI_SENSITIVE_LOGGING_ENABLED=false

AUTH_UPLOAD_MAX_SIZE_BYTES=2097152
