# 复制为 .env.prod 后替换所有 replace-with-* 值。
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
DASHSCOPE_CHAT_MODEL=qwen3.7-flash
DASHSCOPE_CHAT_MULTI_MODEL=true
SEARCH_API_KEY=

AUTH_JWT_SECRET=replace-with-a-random-64-character-hex-string
AUTH_JWT_EXPIRATION_MS=7200000
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
AUTH_REGISTRATION_ENABLED=false

CHAT_DATABASE_USERNAME=liu_ai_agent
CHAT_DATABASE_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

CHAT_RETENTION_DAYS=365
CHAT_RETENTION_BATCH_SIZE=500
CHAT_RETENTION_CLEANUP_CRON=0 15 3 * * *
AI_SENSITIVE_LOGGING_ENABLED=false
AI_REQUESTS_PER_MINUTE=30

# Agent Memory 预算。模型或系统 Prompt 变更后应重新校准。
CHAT_MEMORY_MODEL_INPUT_TOKEN_BUDGET=12000
CHAT_MEMORY_RESERVED_TOKEN_BUDGET=4000
CHAT_MEMORY_TOKEN_BUDGET=2000
CHAT_MEMORY_RAW_RECENT_TOKEN_TARGET=5000
CHAT_MEMORY_MAX_CANDIDATE_TURNS=100
CHAT_MEMORY_MAX_SUMMARY_CHARS=6000
CHAT_MEMORY_MAX_FACTS_IN_CONTEXT=50

AUTH_UPLOAD_MAX_SIZE_BYTES=2097152
APP_PORT=8080
